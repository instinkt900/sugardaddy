# Copy to .env (same directory) and fill in. Never commit .env.
SUGARDADDY_LIBRE_EMAIL=you@example.com
SUGARDADDY_LIBRE_PASSWORD=your-librelinkup-password
# Only needed to run the one-time `backfill` from Home Assistant:
SUGARDADDY_HA_TOKEN=
# Web Push signing key, only needed if [notify] is enabled. Mint one with
# `sugardaddy vapid-keys`. Anyone holding it can push to your devices.
SUGARDADDY_VAPID_PRIVATE_KEY=
